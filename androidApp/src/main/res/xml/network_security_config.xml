<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuration pour ngrok -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">latch-tummy-unfrosted.ngrok-free.dev</domain>
        <domain includeSubdomains="true">ngrok-free.dev</domain>
    </domain-config>
    
    <!-- HTTP pour localhost (développement) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.88.15</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    
    <!-- Autoriser tous les certificats en développement -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>