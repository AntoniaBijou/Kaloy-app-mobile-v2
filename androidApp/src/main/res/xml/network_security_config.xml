<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuration pour LocalTunnel -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">chatty-seals-trade.loca.lt</domain>
        <domain includeSubdomains="true">twelve-wolves-happen.loca.lt</domain>
        <domain includeSubdomains="true">loca.lt</domain>
    </domain-config>
    
    <!-- HTTP pour développement local (WiFi direct) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.129</domain>
        <domain includeSubdomains="false">192.168.88.15</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    
    <!-- Autoriser tous les certificats en développement -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>